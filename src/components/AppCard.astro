---
import type { AppItem } from '../data/apps';
import { withBase } from '../lib/url';

interface Props {
  app: AppItem;
}

const { app } = Astro.props;

type MediaSlide =
  | { type: 'video'; src: string; poster?: string }
  | { type: 'image'; src: string };

const media: MediaSlide[] = [
  ...(app.demoVideo ? [{ type: 'video' as const, ...app.demoVideo }] : []),
  ...(app.screenshots ?? []).map((src) => ({ type: 'image' as const, src })),
];
---

<article class="app-card">
  {
    media.length > 0 && (
      <div class="app-media" data-app-media>
        <div class="app-media-track">
          {media.map((slide, index) => (
            <div class="app-media-slide" data-index={index} data-active={index === 0}>
              {slide.type === 'video' ? (
                <video
                  controls
                  preload="none"
                  poster={slide.poster ? withBase(slide.poster) : undefined}
                >
                  <source src={withBase(slide.src)} type="video/mp4" />
                </video>
              ) : (
                <img
                  src={withBase(slide.src)}
                  alt={`${app.name} スクリーンショット ${media
                    .slice(0, index + 1)
                    .filter((m) => m.type === 'image').length}`}
                  loading="lazy"
                />
              )}
            </div>
          ))}
        </div>
        {media.length > 1 && (
          <div class="app-media-dots" role="tablist" aria-label={`${app.name} のメディア一覧`}>
            {media.map((_, index) => (
              <button
                type="button"
                class="app-media-dot"
                data-index={index}
                data-active={index === 0}
                data-sound="click"
                aria-label={`${index + 1}枚目を表示`}
                aria-selected={index === 0}
              />
            ))}
          </div>
        )}
      </div>
    )
  }
  <div class="app-card-body">
    <div class="app-card-head">
      <h3>{app.name}</h3>
      {app.badge && <span class="badge">{app.badge}</span>}
    </div>
    <p>{app.description}</p>
    {
      app.audioGroups && app.audioGroups.length > 0 && (
        <div class="app-audio">
          {app.audioGroups.map((group) => (
            <div class="app-audio-group">
              {group.title && <p class="app-audio-title">{group.title}</p>}
              <ul class="app-audio-list">
                {group.samples.map((sample) => (
                  <li>
                    <span class="app-audio-label">{sample.label}</span>
                    <audio controls preload="none" src={withBase(sample.src)} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
    <div class="app-card-foot">
      {
        app.link ? (
          <a href={app.link} target="_blank" rel="noopener noreferrer" data-sound="click">
            リポジトリを見る →
          </a>
        ) : (
          app.note && <span class="note">{app.note}</span>
        )
      }
    </div>
  </div>
</article>

<style>
  .app-card {
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .app-media {
    position: relative;
  }

  .app-media-track {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #000;
  }

  .app-media-slide {
    display: none;
    position: absolute;
    inset: 0;
  }

  .app-media-slide[data-active='true'] {
    display: block;
  }

  .app-media-slide video,
  .app-media-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .app-media-dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.75rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .app-media-dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border-radius: 999px;
    border: 1px solid rgba(233, 230, 224, 0.6);
    background: rgba(10, 10, 12, 0.4);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .app-media-dot:hover {
    transform: scale(1.15);
  }

  .app-media-dot[data-active='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .app-card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .app-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .app-card-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .badge {
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-soft);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .app-card p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .app-audio {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .app-audio-title {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.4rem;
  }

  .app-audio-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .app-audio-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .app-audio-label {
    flex: 0 0 4.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .app-audio-list audio {
    flex: 1;
    height: 2rem;
  }

  .app-card-foot a {
    font-size: 0.88rem;
    color: var(--color-accent);
    transition: opacity 0.2s ease;
  }

  .app-card-foot a:hover {
    opacity: 0.75;
  }
</style>

<script>
  import '../scripts/app-media-slider';
</script>
