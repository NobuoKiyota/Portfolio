---
import type { AppItem } from '../data/apps';
import { withBase } from '../lib/url';

interface Props {
  app: AppItem;
}

const { app } = Astro.props;
---

<article class="app-card">
  {
    app.screenshots && app.screenshots.length > 0 && (
      <div class="app-shots">
        {app.screenshots.map((src) => (
          <img src={withBase(src)} alt={`${app.name} スクリーンショット`} loading="lazy" />
        ))}
      </div>
    )
  }
  <div class="app-card-body">
    <div class="app-card-head">
      <h3>{app.name}</h3>
      {app.badge && <span class="badge">{app.badge}</span>}
    </div>
    <p>{app.description}</p>
    {
      app.audioGroups && app.audioGroups.length > 0 && (
        <div class="app-audio">
          {app.audioGroups.map((group) => (
            <div class="app-audio-group">
              {group.title && <p class="app-audio-title">{group.title}</p>}
              <ul class="app-audio-list">
                {group.samples.map((sample) => (
                  <li>
                    <span class="app-audio-label">{sample.label}</span>
                    <audio controls preload="none" src={withBase(sample.src)} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
    <div class="app-card-foot">
      {
        app.link ? (
          <a href={app.link} target="_blank" rel="noopener noreferrer" data-sound="click">
            リポジトリを見る →
          </a>
        ) : (
          app.note && <span class="note">{app.note}</span>
        )
      }
    </div>
  </div>
</article>

<style>
  .app-card {
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .app-shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1px;
    background: var(--color-border);
  }

  .app-shots img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #000;
  }

  .app-card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .app-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .app-card-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .badge {
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-soft);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .app-card p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .app-audio {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .app-audio-title {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.4rem;
  }

  .app-audio-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .app-audio-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .app-audio-label {
    flex: 0 0 4.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .app-audio-list audio {
    flex: 1;
    height: 2rem;
  }

  .app-card-foot a {
    font-size: 0.88rem;
    color: var(--color-accent);
    transition: opacity 0.2s ease;
  }

  .app-card-foot a:hover {
    opacity: 0.75;
  }
</style>
