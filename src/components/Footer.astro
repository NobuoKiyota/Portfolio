---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>&copy; {year} Nobuo Kiyota</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
  }

  .footer-inner {
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .footer-inner p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
  }
</style>
