<button id="sound-toggle" class="sound-toggle" type="button" aria-pressed="false" aria-label="環境音を切り替える">
  <span class="sound-toggle-dot" aria-hidden="true"></span>
  <span class="sound-toggle-label">Sound</span>
</button>

<style>
  .sound-toggle {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: rgba(19, 19, 23, 0.9);
    backdrop-filter: blur(6px);
    color: var(--color-text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .sound-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .sound-toggle-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-text-muted);
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle-dot {
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .sound-toggle[aria-pressed='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
