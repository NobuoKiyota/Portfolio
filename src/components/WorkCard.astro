---
import type { Work } from '../data/works';

interface Props {
  work: Work;
}

const { work } = Astro.props;
---

<article class:list={['work-card', { 'is-placeholder': work.comingSoon }]}>
  {
    work.youtubeId ? (
      <div class="work-embed">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${work.youtubeId}`}
          title={work.title}
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    ) : (
      <div class="work-embed work-embed-placeholder" aria-hidden="true">
        <span>Coming Soon</span>
      </div>
    )
  }
  <div class="work-body">
    <h3>{work.title}</h3>
    {
      work.tags.length > 0 && (
        <ul class="work-tags">
          {work.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    <p>{work.description}</p>
  </div>
</article>

<style>
  .work-card {
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    margin-bottom: 2rem;
    overflow: hidden;
  }

  .work-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .work-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .work-embed-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: repeating-linear-gradient(
      135deg,
      var(--color-bg-elevated),
      var(--color-bg-elevated) 10px,
      #0f0f13 10px,
      #0f0f13 20px
    );
  }

  .work-body {
    padding: 1.5rem;
  }

  .work-body h3 {
    margin-bottom: 0.5rem;
  }

  .work-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .work-tags li {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-soft);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .work-body p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .is-placeholder {
    opacity: 0.7;
  }
</style>
