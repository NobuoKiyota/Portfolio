---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import SectionDots from '../components/SectionDots.astro';
import SectionArrows from '../components/SectionArrows.astro';
import { apps } from '../data/apps';
import { pluginsNote } from '../data/plugins';

const sections = [
  { id: 'apps-intro', label: 'Intro' },
  ...apps.map((app, index) => ({ id: `apps-${index}`, label: app.name })),
  { id: 'apps-plugins', label: 'More' },
];
---

<BaseLayout title="Apps" description="Nobuo Kiyota が開発するAIアプリ・ツール、VSTプラグイン">
  <div class="snap-container">
    <section id="apps-intro" class="snap-section page-head" data-decor="APPS">
      <div class="container">
        <p class="eyebrow">Apps</p>
        <h1>AIアプリ・ツール</h1>
        <p class="page-lead">制作の裏側で使っている、自作のツール群です。</p>
      </div>
    </section>

    {
      apps.map((app, index) => (
        <section id={`apps-${index}`} class="snap-section app-item">
          <div class="container">
            <div class="app-item-inner">
              <AppCard app={app} />
            </div>
          </div>
        </section>
      ))
    }

    <section id="apps-plugins" class="snap-section section">
      <div class="container">
        <div class="section-head">
          <h2>More</h2>
        </div>
        <p class="plugin-note">{pluginsNote}</p>
      </div>
    </section>
  </div>
  <SectionDots sections={sections} />
  <SectionArrows sections={sections} />
</BaseLayout>

<style>
  .page-lead {
    max-width: 34rem;
    color: var(--color-text);
    font-style: italic;
  }

  .app-item-inner {
    max-width: 640px;
    margin: 0 auto;
    width: 100%;
  }

  .plugin-note {
    color: var(--color-text-muted);
    max-width: 40rem;
    font-size: 0.92rem;
  }
</style>
