---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import SectionDots from '../components/SectionDots.astro';
import { apps } from '../data/apps';
import { plugins, pluginsNote } from '../data/plugins';

const sections = [
  { id: 'apps-intro', label: 'Intro' },
  ...apps.map((app, index) => ({ id: `apps-${index}`, label: app.name })),
  { id: 'apps-plugins', label: 'VST Plugins' },
];
---

<BaseLayout title="Apps" description="Nobuo Kiyota が開発するAIアプリ・ツール、VSTプラグイン">
  <div class="snap-container">
    <section id="apps-intro" class="snap-section container page-head" data-decor="APPS">
      <p class="eyebrow">Apps</p>
      <h1>AIアプリ・ツール</h1>
      <p class="page-lead">制作の裏側で使っている、自作のツール群です。</p>
    </section>

    {
      apps.map((app, index) => (
        <section id={`apps-${index}`} class="snap-section container app-item">
          <div class="app-item-inner">
            <AppCard app={app} />
          </div>
        </section>
      ))
    }

    <section id="apps-plugins" class="snap-section container section">
      <div class="section-head">
        <h2>VST Plugins</h2>
      </div>
      <ul class="plugin-list">
        {plugins.map((name) => <li>{name}</li>)}
      </ul>
      <p class="plugin-note">{pluginsNote}</p>
    </section>
  </div>
  <SectionDots sections={sections} />
</BaseLayout>

<style>
  .page-lead {
    max-width: 34rem;
    color: var(--color-text);
    font-style: italic;
  }

  .app-item-inner {
    max-width: 640px;
    margin: 0 auto;
    width: 100%;
  }

  .plugin-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .plugin-list li {
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    padding: 0.5rem 0.9rem;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .plugin-note {
    color: var(--color-text-muted);
    max-width: 40rem;
    font-size: 0.92rem;
  }
</style>
