---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Profile" description="Nobuo Kiyota のプロフィール">
  <div class="snap-container">
    <section id="profile-main" class="snap-section profile-head" data-decor="PROFILE">
      <div class="container">
        <div class="monogram" aria-hidden="true">NK</div>
        <p class="eyebrow">Profile</p>
        <h1>Nobuo Kiyota</h1>
        <p class="page-lead">プロフィールは準備中です。近日公開します。</p>
        <p class="note">SNS・連絡先リンクは近日追加予定です。</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .profile-head {
    padding: 2rem 0;
  }

  .monogram {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: 1.75rem;
  }

  .page-lead {
    max-width: 34rem;
    color: var(--color-text);
    font-style: italic;
  }
</style>
