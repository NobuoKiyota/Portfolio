---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Profile" description="Nobuo Kiyota のプロフィール">
  <section class="container profile-head">
    <div class="monogram" aria-hidden="true">NK</div>
    <p class="eyebrow">Profile</p>
    <h1>Nobuo Kiyota</h1>
    <p class="page-lead">プロフィールは準備中です。近日公開します。</p>
  </section>

  <section class="container profile-links">
    <p class="note">SNS・連絡先リンクは近日追加予定です。</p>
  </section>
</BaseLayout>

<style>
  .profile-head {
    padding: 4rem 1.5rem 2.5rem;
  }

  .monogram {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: 1.75rem;
  }

  .page-lead {
    max-width: 34rem;
    color: var(--color-text-muted);
  }

  .profile-links {
    padding-bottom: 3rem;
  }
</style>
