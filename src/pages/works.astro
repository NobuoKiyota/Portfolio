---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import SectionDots from '../components/SectionDots.astro';
import SectionArrows from '../components/SectionArrows.astro';
import { works } from '../data/works';

const sections = [
  { id: 'works-intro', label: 'Intro' },
  ...works.map((work, index) => ({ id: `works-${index}`, label: work.title })),
];
---

<BaseLayout title="Works" description="Nobuo Kiyota の楽曲・映像作品">
  <div class="snap-container">
    <section id="works-intro" class="snap-section page-head" data-decor="WORKS">
      <div class="container">
        <p class="eyebrow">Works</p>
        <h1>楽曲・映像</h1>
        <p class="page-lead">自主制作の映像と、その世界観に合わせて制作した楽曲を紹介します。</p>
      </div>
    </section>
    {
      works.map((work, index) => (
        <section id={`works-${index}`} class="snap-section work-item">
          <div class="container">
            <WorkCard work={work} />
          </div>
        </section>
      ))
    }
  </div>
  <SectionDots sections={sections} />
  <SectionArrows sections={sections} />
</BaseLayout>

<style>
  .page-lead {
    max-width: 34rem;
    color: var(--color-text);
    font-style: italic;
  }

  .work-item :global(.work-card) {
    margin-bottom: 0;
  }
</style>
